app.dev.why.node_modules = si supprimé : réinstallé depuis package.json au prochain npm / pnpm / yarn install
app.dev.why.next = si supprimé : recréé au prochain next dev ou next build
app.dev.why.gradle = si supprimé : recréé la prochaine fois que Gradle tourne dans ce projet
app.dev.why.gradle_build = si supprimé : recréé au prochain gradle build
app.dev.why.derived_data = si supprimé : Xcode le recrée à la prochaine compilation
app.dev.why.standalone_target = si supprimé : recréé quand cargo compile avec ce CARGO_TARGET_DIR
app.dev.why.npm_cache = si supprimé : npm retélécharge les paquets quand il en a besoin
app.dev.why.pnpm_store = si supprimé : pnpm retélécharge les paquets à la prochaine installation
app.dev.why.gradle_cache = si supprimé : Gradle retélécharge les dépendances à la prochaine compilation
