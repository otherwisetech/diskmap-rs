app.dev.why.target = se apagar: é recriado no próximo cargo build / mvn
app.dev.why.node_modules = se apagar: é reinstalado a partir do package.json no próximo npm / pnpm / yarn install
app.dev.why.next = se apagar: é recriado no próximo next dev ou next build
app.dev.why.gradle = se apagar: é recriado na próxima vez que o Gradle rodar neste projeto
app.dev.why.gradle_build = se apagar: é recriado no próximo gradle build
app.dev.why.derived_data = se apagar: o Xcode o recria na próxima compilação
app.dev.why.standalone_target = se apagar: é recriado quando o cargo compilar com este CARGO_TARGET_DIR
app.dev.why.npm_cache = se apagar: o npm baixa os pacotes de novo quando precisar
app.dev.why.pnpm_store = se apagar: o pnpm baixa os pacotes de novo na próxima instalação
app.dev.why.gradle_cache = se apagar: o Gradle baixa as dependências de novo na próxima compilação
